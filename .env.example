# ==============================================================================
# MILO CHEER CAMPAIGN - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép tệp này thành .env và điền các giá trị thực tế của bạn
# ==============================================================================

# --- 1. SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=production
MATERIAL_DIR=/path/to/MILO/materials

# --- 2. ELEVENLABS AI VOICE TTS API ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL_ID=eleven_v3

# --- 3. ABENLA SMS & OTP GATEWAY ---
ABENLA_API_URL=https://api.abenla.com/api/SendSms
ABENLA_LOGIN_NAME=your_abenla_login_name
ABENLA_PASSWORD=your_abenla_password
ABENLA_ZALO_SERVICE_TYPE_ID=537
ABENLA_ZALO_BRAND_NAME=ZOTP
ABENLA_VOICE_SERVICE_TYPE_ID=527
ABENLA_VOICE_BRAND_NAME=VoiceOTP271

# --- 4. FRONTEND CONFIGURATION (VITE) ---
VITE_BACKEND_URL=https://your-backend-domain.com
